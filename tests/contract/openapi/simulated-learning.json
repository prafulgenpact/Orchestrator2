{
  "/api/ask": {
    "POST": {
      "params": [
        "question",
        "concept_title",
        "track_name",
        "theory_context"
      ],
      "required": [
        "question",
        "concept_title",
        "track_name",
        "theory_context"
      ],
      "types": {
        "concept_title": "string",
        "question": "string",
        "theory_context": "string",
        "track_name": "string"
      }
    }
  },
  "/api/execute": {
    "POST": {
      "params": [
        "code",
        "timeout"
      ],
      "required": [
        "code"
      ],
      "types": {
        "code": "string",
        "timeout": "integer"
      }
    }
  },
  "/api/health": {
    "GET": {
      "params": [],
      "required": [],
      "types": {}
    }
  },
  "/{full_path}": {
    "GET": {
      "params": [
        "full_path"
      ],
      "required": [
        "full_path"
      ],
      "types": {
        "full_path": "string"
      }
    }
  }
}
