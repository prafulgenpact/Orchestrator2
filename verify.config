# Verification contract configuration (shell-sourced by scripts/verify.sh).
# HUMAN-OWNED FILE: agents are blocked from editing it (gate_edit.sh).

# Checks that MUST run and pass for a proof to be PASS.
# A required check that is skipped (tool missing, dir missing) fails the proof.
# Add web checks when you have a frontend: web-lint web-types web-unit
REQUIRED_CHECKS="py-lint py-format py-types py-unit e2e secrets"

# Auto-commit the proof after a PASS on a clean tree (0 = manual 'make seal').
AUTOSEAL=1

# Conventional commit messages enforced by githooks/commit-msg (0 = off).
CONVENTIONAL_COMMITS=1

# Extra args for pip-audit (e.g. accept a vetted CVE: --ignore-vuln GHSA-xxxx).
# Any failing check fails the proof — suppressions are deliberate and visible.
# GHSA-6w46-j5rx-g56g: pytest <9.0.3 creates predictable tmp-dir permissions.
# Low severity, only exploitable on shared multi-user hosts (not this solo/CI
# setup). Accepted because the only fix is a pytest 8->9 major bump; revisit when
# the toolchain is upgraded deliberately (BOOTSTRAP_LATEST=1).
DEP_AUDIT_ARGS="--ignore-vuln GHSA-6w46-j5rx-g56g"

# Changed-lines coverage floor for diff-cover (0 = report only). Global floor
# is COVERAGE_MIN; this one stops NEW code from shipping untested.
DIFF_COVERAGE_MIN=0

# Minimum unit-test line coverage percent (pytest --cov-fail-under).
COVERAGE_MIN=90

# 1 = out-of-scope changes fail verification (see specs/tasks/ACTIVE.md 'Scope:').
STRICT_SCOPE=1

# 1 = agents cannot edit code without an ACTIVE task file (plan-then-execute,
# mechanically enforced by gate_edit.sh). Docs/specs edits are always allowed.
REQUIRE_ACTIVE_TASK=1

# Consecutive FAIL proofs on the same check before the doom-loop gate triggers.
LOOP_THRESHOLD=3

# Optional: proof expiry in hours for check_proof.py (0 = disabled; the
# fingerprint binding already guarantees code identity).
PROOF_MAX_AGE_HOURS=0

# Base branch for drift comparison.
BASE_BRANCH=Orchestrator2

# Paths for mypy / coverage if not the default src layout.
# MYPY_PATHS="src"
# COV_PATHS="src"

# Frontend: directory containing package.json (rename web.template/ -> web/ to activate).
# WEB_DIR="web"
# WEB_E2E=1   # also run Playwright e2e via 'npm run test:e2e'

# Custom check lanes: semicolon-separated "name:command" pairs.
# Add their names to REQUIRED_CHECKS to make them mandatory for a PASS proof.
# Commands must not contain ';' — wrap complex logic in a script and call it.
# EXTRA_CHECKS="docker-build:docker build -q .;security:bandit -q -r src;agent-eval:python3 evals/run.py"
