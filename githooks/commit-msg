#!/usr/bin/env bash
# Conventional commits: machine-readable history (changelogs, release automation,
# auditor archaeology). Disable with CONVENTIONAL_COMMITS=0 in verify.config.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
[ -f verify.config ] && . ./verify.config
[ "${CONVENTIONAL_COMMITS:-1}" = "1" ] || exit 0

MSG=$(head -n1 "$1")
case "$MSG" in
  Merge\ *|Revert\ *|fixup!*|squash!*|proof:*) exit 0 ;;
esac

if ! printf '%s' "$MSG" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: .{1,100}$'; then
  {
    echo "[commit-msg] ⛔ not a conventional commit: \"$MSG\""
    echo "  format:  type(scope): summary"
    echo "  types :  feat fix docs style refactor perf test build ci chore revert"
    echo "  example: fix(matching): handle POs with duplicate line numbers"
    echo "  (disable: CONVENTIONAL_COMMITS=0 in verify.config — human decision)"
  } >&2
  exit 1
fi
exit 0
